# /etc/systemd/system/net-logger-plus.service
#
# Runs Net Logger Plus as an unprivileged, sandboxed service.
#   App code : /opt/net-logger-plus            (read-only to the service)
#   Settings : /etc/net-logger-plus/net-logger-plus.env
#   Data     : /var/lib/net-logger-plus/db.json (created and owned by systemd)
[Unit]
Description=Net Logger Plus amateur radio net manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/net-logger-plus
ExecStart=/usr/bin/node /opt/net-logger-plus/src/server.js
Environment=NODE_ENV=production
EnvironmentFile=/etc/net-logger-plus/net-logger-plus.env

# A throw-away system user, created on start and removed on stop. Data lives in StateDirectory.
DynamicUser=yes
StateDirectory=net-logger-plus
StateDirectoryMode=0700
UMask=0077

Restart=on-failure
RestartSec=3
# Net Logger Plus flushes its data to disk on SIGTERM; give it time to finish.
TimeoutStopSec=15

# --- Sandboxing -------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Do NOT enable MemoryDenyWriteExecute: Node's JavaScript engine needs writable+executable memory.

[Install]
WantedBy=multi-user.target
