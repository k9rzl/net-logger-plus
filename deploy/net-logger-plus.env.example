# /etc/net-logger-plus/net-logger-plus.env   (mode 0600, read by systemd; never commit this file)

# Public address people type in the browser: a domain or just an IP address.
#   https://nets.example.org   https://203.0.113.10   https://[2001:db8::10]   http://203.0.113.10 (not encrypted!)
# The install script sets this for you (--domain or --ip).
BASE_URL=https://nets.example.org

# Listen on this machine only; Caddy forwards to it.
HOST=127.0.0.1
PORT=3000

# Trust the X-Forwarded-For header from the proxy for per-client rate limits.
# Safe ONLY because HOST=127.0.0.1 means nothing but Caddy can reach the app.
TRUST_PROXY=1

# Signs session cookies. At least 32 characters. The install script generates one.
SESSION_SECRET=CHANGE_ME

# Where data is kept (JSON file). Leave as is, or set MONGODB_URI below instead.
DATA_FILE=/var/lib/net-logger-plus/db.json

# Sign-in emails: POST {to, subject, text} as JSON to this URL (any mail API relay).
# If empty, sign-in links are written to the service log: sudo journalctl -u net-logger-plus -f
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# QRZ lookup (needs a QRZ XML subscription). Leave empty to turn it off.
QRZ_USERNAME=
QRZ_PASSWORD=
QRZ_REQUIRE=0

# MongoDB instead of the JSON file (needs `npm install mongodb` in /opt/net-logger-plus).
MONGODB_URI=
MONGODB_DB=net-logger-plus
