# Copy to .env. Everything here is optional for local development.
PORT=3000
# Interface to listen on. Default 127.0.0.1 (reachable only from this machine, e.g. via Caddy/nginx).
# Use 0.0.0.0 only for containers or a trusted LAN. Never combine TRUST_PROXY=1 with a publicly reachable port.
HOST=127.0.0.1
# Public URL of your instance (used in sign-in links and cookie flags)
BASE_URL=http://localhost:3000
# REQUIRED in production: 32+ random characters  (openssl rand -base64 48)
SESSION_SECRET=
# Set to production on a real host. Enforces SESSION_SECRET and refuses DEV_LINKS.
NODE_ENV=development
# Dev only: show the sign-in link on screen instead of emailing it. Never in production.
DEV_LINKS=0
# Email delivery: POST {to, subject, text} as JSON to this URL (any mail API relay).
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Set to 1 only when behind exactly one trusted reverse proxy (nginx, Caddy, Fly...)
TRUST_PROXY=0
DATA_FILE=data/db.json

# Storage: leave empty to use the JSON file above. Set to use MongoDB (needs: npm install mongodb).
MONGODB_URI=
MONGODB_DB=net-logger-plus

# QRZ callsign lookup (needs a QRZ XML data subscription). Leave empty to turn it off.
QRZ_USERNAME=
QRZ_PASSWORD=
# 1 = only accept callsigns QRZ knows about. Checks existence, not that the user holds the licence.
QRZ_REQUIRE=0
